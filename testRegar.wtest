import wollok.game.*
import granja.*
import personaje.*
import direcciones.*
import elementos.*

describe "hector riega los cultivos" {
    
   method initialize() {
            
        game.clear()
        farmVille.dibujarMapa() 
        hector.position(game.at(5,5))
   }

    test "hector coloca un maiz y lo riega correctamente" {

        const maiz = new Maiz(image = "corn_baby.png")
        hector.mover(derecha)
        hector.sembrar(maiz)

        //NECESITE TRADUCIR, BAJAR EL TEXTO DEL GAME A ALGO QUE SE PUEDA
        //TESTEAR ACA, EN LA PARTE INTERPRETE DEL MODULO DEL PERSONAJE SE
        //ENCUENTRA PROGRAMADO
        
        assert.equals("sembrando... Maiz", hector.mensajePersonaje())
        
        assert.equals([maiz],hector.cultivosSembrados())
        assert.equals(game.at(6,5),hector.position())
        assert.equals(game.at(6,5),maiz.position())

        hector.regar()

        assert.equals("regando... Maiz", hector.mensajePersonaje())

        assert.equals([],hector.cultivosCosechados())
        assert.equals(0,hector.cantidadCultivosCosechados())
        assert.equals([maiz],hector.cultivosSembrados())
        assert.equals(game.at(6,5),hector.position())
        assert.equals(game.at(6,5),maiz.position())

    }
    test "hector coloca un trigo y lo riega correctamente" {
     
        const trigo = new Trigo(image = "wheat_0.png")
        hector.mover(izquierda)
        hector.sembrar(trigo)

        hector.regar()

        assert.equals("regando... Trigo", hector.mensajePersonaje())
        
        assert.equals([trigo],hector.cultivosSembrados())
        assert.equals(game.at(4,5),hector.position())
        assert.equals(game.at(4,5),trigo.position())
    }

    test "hector coloca un tomaco y lo riega correctamente subiendolo una parcela" {

        const tomaco = new Tomaco(image = "tomaco.png")
        hector.mover(abajo)
        hector.sembrar(tomaco)

        hector.regar()

        assert.equals("regando... Tomaco", hector.mensajePersonaje())
        
        assert.equals([tomaco],hector.cultivosSembrados())
        assert.equals(game.at(5,4),hector.position())
        assert.equals(game.at(5,5),tomaco.position())

    }


    test "hector coloca un tomaco y lo riega correctamente subiendolo una parcela
         pero llega a la parte de arriba y se telestransporta hacia abajo" {

        
        hector.position(game.at(5,5))
        const tomaco = new Tomaco(image = "tomaco.png")
        hector.mover(arriba)
        
        hector.sembrar(tomaco)
        hector.regar()

        assert.equals("regando... Tomaco",hector.mensajePersonaje())

        assert.equals([tomaco],hector.cultivosSembrados())
        assert.equals(game.at(5,6),hector.position())
        assert.equals(game.at(5,0),tomaco.position())

        //NO ME SALIO ESTO
        //assert.equals("teletransportacion!", tomaco.mensajePersonaje())
    }


    test "hector coloca un tomaco intenta regarlo pero no puede ya que 
    lo obstruye un elemento, en este caso un mercado" {
        
        //hector.position(game.at(5,5))
        const tomaco = new Tomaco(image = "tomaco.png")

        const mercadoDos = new Mercado(position = game.at(5,6),monedasParaAbonar = 1000)
        game.addVisual(mercadoDos)
        
        hector.sembrar(tomaco)
        
        assert.equals("sembrando... Tomaco",hector.mensajePersonaje())

        assert.throwsException({hector.regar()})
        
        assert.equals([tomaco],hector.cultivosSembrados())      
    }


    test "hector intenta regar en parcela vacia y no puede" {
      
        hector.regar()

        assert.equals("imposible regar aqui!,parcela vacia", hector.mensajePersonaje())
        
        assert.equals(game.at(5,5),hector.position())
        
    }

    test "hector intenta regar en el mercado y no puede" {
      
        const mercadoDos = new Mercado(position = game.at(5,6),monedasParaAbonar = 1000)
        game.addVisual(mercadoDos)

        hector.mover(arriba)

        hector.regar()

        assert.equals("imposible regar aqui! esto no es un cultivo",hector.mensajePersonaje())
        
        assert.equals(game.at(5,6),hector.position())
    }

    test "hector intenta regar en el aspersor y no puede" {
      
        const aspersor = new Aspersor()

        hector.mover(arriba)
        hector.ponerAspersor(aspersor)

        hector.regar()

        assert.equals("imposible regar aqui! esto no es un cultivo",hector.mensajePersonaje())
        
        assert.equals(game.at(5,6),hector.position())
    }


}