import wollok.game.*
import granja.*
import personaje.*
import direcciones.*
import elementos.*

describe "hector cosecha los cultivos" {
    
   method initialize() {
            
        game.clear()
        farmVille.dibujarMapa() 
        hector.position(game.at(5,5))
   }

   
   test "hector siembra, riega y cosecha maiz" {
     
     const maiz = new Maiz(image = "corn_baby.png")
     hector.mover(derecha)
     hector.sembrar(maiz)

     
     //NECESITE TRADUCIR, BAJAR EL TEXTO DEL GAME A ALGO QUE SE PUEDA
     //TESTEAR ACA, EN LA PARTE INTERPRETE DEL MODULO DEL PERSONAJE SE
     //ENCUENTRA PROGRAMADO
     
     assert.equals("sembrando... Maiz", hector.mensajePersonaje())
     

     assert.equals([maiz],hector.cultivosSembrados())
     assert.equals(game.at(6,5),hector.position())
     assert.equals(game.at(6,5),maiz.position())


     hector.regar()

     assert.equals("regando... Maiz", hector.mensajePersonaje())

     assert.equals([],hector.cultivosCosechados())
     assert.equals(0,hector.cantidadCultivosCosechados())
     assert.equals([maiz],hector.cultivosSembrados())
     assert.equals(game.at(6,5),hector.position())
     assert.equals(game.at(6,5),maiz.position())

     hector.cosechar()

     assert.equals("coseché! Maiz ve al mercado, vendelo presionando la v", hector.mensajePersonaje())

     assert.equals([maiz],hector.cultivosCosechados())
     assert.equals(1,hector.cantidadCultivosCosechados())
    
   }
   
   test "hector siembra, riega y cosecha tomaco" {

      const tomaco = new Tomaco(image = "tomaco.png")
      hector.sembrar(tomaco)

      assert.equals("sembrando... Tomaco", hector.mensajePersonaje())
      
      hector.regar()
      
      assert.equals("regando... Tomaco", hector.mensajePersonaje())

      assert.equals([tomaco],hector.cultivosSembrados())
      assert.equals(game.at(5,5),hector.position())
      assert.equals(game.at(5,6),tomaco.position())
    
      hector.mover(arriba)
        
      hector.cosechar()

      assert.equals("coseché! Tomaco ve al mercado, vendelo presionando la v", hector.mensajePersonaje())

      assert.equals([tomaco],hector.cultivosCosechados())
      assert.equals(1,hector.cantidadCultivosCosechados())
    
   }


   test "hector siembre y cosecha directamente tomaco porque el tomaco
        siempre se puede cosechar" {
     
      const tomaco = new Tomaco(image = "tomaco.png")
      hector.sembrar(tomaco)

      assert.equals("sembrando... Tomaco", hector.mensajePersonaje())
      
      hector.cosechar()

      assert.equals("coseché! Tomaco ve al mercado, vendelo presionando la v", hector.mensajePersonaje())

      assert.equals([tomaco],hector.cultivosCosechados())
      assert.equals(1,hector.cantidadCultivosCosechados())
  
   }


   test "hector riega hasta la evolucion 2 del trigo y la cosecha " {
     
     const trigo = new Trigo(image = "wheat_0.png")
     hector.sembrar(trigo)

     assert.equals("sembrando... Trigo", hector.mensajePersonaje())
     
     assert.equals([trigo],hector.cultivosSembrados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())

     hector.regar()

     assert.equals("regando... Trigo",hector.mensajePersonaje())
     
     assert.equals([trigo],hector.cultivosSembrados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())

     hector.regar()

     assert.equals("regando... Trigo",hector.mensajePersonaje())
     
     assert.equals([trigo],hector.cultivosSembrados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())

     hector.cosechar()

     assert.equals("coseché! Trigo ve al mercado, vendelo presionando la v", hector.mensajePersonaje())

     assert.equals([trigo],hector.cultivosCosechados())
     assert.equals(1,hector.cantidadCultivosCosechados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())
   }



    test "hector riega hasta la evolucion 1 del trigo intenta 
         cosecharlo pero no se le permite" {
     
     const trigo = new Trigo(image = "wheat_0.png")
     hector.sembrar(trigo)

     assert.equals("sembrando... Trigo", hector.mensajePersonaje())
     
     assert.equals([trigo],hector.cultivosSembrados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())

     hector.regar()

     assert.equals("regando... Trigo",hector.mensajePersonaje())
     
     assert.equals([trigo],hector.cultivosSembrados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())

     hector.cosechar()

     assert.equals("Este Trigo no es cosechable! tenes que regar con la letra r", hector.mensajePersonaje())

     assert.equals([],hector.cultivosCosechados())
     assert.equals(0,hector.cantidadCultivosCosechados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),trigo.position())
   }


   test "hector intenta cosechar un maiz pero como no fue regado no puede" {

     const maiz = new Maiz(image = "corn_baby.png")
     hector.sembrar(maiz)

     assert.equals("sembrando... Maiz", hector.mensajePersonaje())
     
     assert.equals([maiz],hector.cultivosSembrados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),maiz.position())

     hector.cosechar()

     assert.equals("Este Maiz no es cosechable! tenes que regar con la letra r", hector.mensajePersonaje())

     assert.equals([],hector.cultivosCosechados())
     assert.equals(0,hector.cantidadCultivosCosechados())
     assert.equals(game.at(5,5),hector.position())
     assert.equals(game.at(5,5),maiz.position())

   }


   test "hector intenta cosechar donde hay un mercado y no puede" {

     
      const mercadoDos = new Mercado(position = game.at(5,6),monedasParaAbonar = 1000)
      game.addVisual(mercadoDos)

      hector.mover(arriba)

      hector.cosechar()

      assert.equals("Este Mercado no es cosechable! tenes que regar con la letra r",hector.mensajePersonaje())
      
      assert.equals(game.at(5,6),hector.position())

   }


   test "hector intenta cosechar donde hay un aspersor y no puede" {

     const aspersor = new Aspersor()

        hector.mover(arriba)
        hector.ponerAspersor(aspersor)

        hector.cosechar()

        assert.equals("Este Aspersor no es cosechable! tenes que regar con la letra r",hector.mensajePersonaje())
        
        assert.equals(game.at(5,6),hector.position())
   }

   
   
}