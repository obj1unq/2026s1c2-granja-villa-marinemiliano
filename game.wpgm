import wollok.game.*
import personaje.*
import elementos.*
import granja.*
import direcciones.*


program farmville {

	//CONFIG	
	game.title("La granja")
	
	farmVille.dibujarMapa()
	game.ground("ground.png")

	game.addVisualCharacter(hector)

	keyboard.a().onPressDo({ hector.mover(izquierda)})
	keyboard.d().onPressDo({ hector.mover(derecha)})
	keyboard.w().onPressDo({ hector.mover(arriba)})
	keyboard.s().onPressDo({ hector.mover(abajo)})	

	keyboard.m().onPressDo({hector.sembrar(new Maiz(image = "corn_baby.png"))})
	keyboard.t().onPressDo({hector.sembrar(new Trigo(image = "wheat_0.png"))})
	keyboard.o().onPressDo({hector.sembrar(new Tomaco(image = "tomaco.png"))})
	
	keyboard.r().onPressDo({hector.regar()})	
	keyboard.c().onPressDo({hector.cosechar()})

	keyboard.v().onPressDo({hector.vender()})
	keyboard.space().onPressDo({hector.estadoContable()})
	
	//uso la f porque la a ya esta ocupada
	
	keyboard.f().onPressDo({hector.ponerAspersor(new Aspersor())})



 	//  COMIENZA
	game.start()
}
